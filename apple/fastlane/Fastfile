# Builds and uploads Technical Officials Scheduler to TestFlight (App Store Connect).
# Runs on GitHub Actions (.github/workflows/release.yml). Everything secret comes from environment variables
# set from GitHub secrets – nothing is stored in the repository. See PUBLISHING.md.
default_platform(:ios)

BUNDLE_ID = ENV["BUNDLE_ID"].to_s.empty? ? "com.bojansurbatovic.toscheduler" : ENV["BUNDLE_ID"]
TEAM_ID = ENV.fetch("APPLE_TEAM_ID")
VERSION = ENV["APP_VERSION"].to_s.empty? ? "1.0.0" : ENV["APP_VERSION"]
BUILD = ENV["BUILD_NUMBER"].to_s.empty? ? Time.now.strftime("%y%m%d%H%M") : ENV["BUILD_NUMBER"]
KEYCHAIN = "fastlane_tmp_keychain"

def asc_key
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_content: ENV.fetch("ASC_KEY_P8_BASE64"),
    is_key_content_base64: true
  )
end

def prepare_keychain(certs)
  setup_ci(force: true)
  # Apple's intermediate certificate, needed to build the signing chain
  sh("curl -fsSL https://www.apple.com/certificateauthority/AppleWWDRCAG3.cer -o \"$RUNNER_TEMP/wwdr.cer\" && " \
     "security import \"$RUNNER_TEMP/wwdr.cer\" -k ~/Library/Keychains/#{KEYCHAIN}-db -A || true")
  certs.each do |path, password|
    import_certificate(certificate_path: path, certificate_password: password, keychain_name: KEYCHAIN, keychain_password: "")
  end
end

def signing_args(profile_name)
  "DEVELOPMENT_TEAM=#{TEAM_ID} PRODUCT_BUNDLE_IDENTIFIER=#{BUNDLE_ID} MARKETING_VERSION=#{VERSION} " \
  "CURRENT_PROJECT_VERSION=#{BUILD} CODE_SIGN_STYLE=Manual CODE_SIGN_IDENTITY='Apple Distribution' " \
  "PROVISIONING_PROFILE_SPECIFIER='#{profile_name}'"
end

platform :ios do
  desc "Build the iPhone / iPad app and upload it to TestFlight"
  lane :beta do
    key = asc_key
    prepare_keychain([[ENV.fetch("DIST_CERT_PATH"), ENV.fetch("DIST_CERT_PASSWORD")]])
    get_provisioning_profile(api_key: key, app_identifier: BUNDLE_ID, team_id: TEAM_ID, platform: "ios")
    profile = lane_context[SharedValues::SIGH_NAME]
    build_app(
      project: "TOScheduler.xcodeproj", scheme: "TOScheduler-iOS", configuration: "Release",
      export_method: "app-store", xcargs: signing_args(profile),
      export_options: { signingStyle: "manual", teamID: TEAM_ID, provisioningProfiles: { BUNDLE_ID => profile } },
      output_directory: "build", output_name: "TOScheduler.ipa"
    )
    upload_to_testflight(api_key: key, ipa: "build/TOScheduler.ipa", skip_waiting_for_build_processing: true)
  end
end

# ---------------------------------------------------------------- App Store listing (both platforms)
def store_platform(p)
  p.to_s == "mac" ? Spaceship::ConnectAPI::Platform::MAC_OS : Spaceship::ConnectAPI::Platform::IOS
end

def metadata_dir
  File.directory?("metadata") ? "metadata" : "fastlane/metadata"   # lane code runs inside fastlane/
end

def display_type(path)
  w, h = File.binread(path, 24)[16, 8].unpack("NN")
  case [w, h]
  when [1320, 2868], [1290, 2796] then "APP_IPHONE_67"
  when [2064, 2752], [2048, 2732] then "APP_IPAD_PRO_3GEN_129"
  when [2880, 1800], [2560, 1600], [1440, 900], [1280, 800] then "APP_DESKTOP"
  end
end

def upload_listing(p)
  mac = p.to_s == "mac"
  shots = File.directory?("screenshots-#{p}") ? "screenshots-#{p}" : "fastlane/screenshots-#{p}"
  # deliver stops when the version has no "App Review Information" yet – create it with the review notes first
  asc_key
  app0 = Spaceship::ConnectAPI::App.find(BUNDLE_ID)
  v0 = app0 && app0.get_edit_app_store_version(platform: store_platform(p))
  if v0
    notes_file = File.join(metadata_dir, "review_information", "notes.txt")
    notes = File.exist?(notes_file) ? File.read(notes_file).strip : ""
    detail = (v0.fetch_app_store_review_detail rescue nil)
    if detail
      if detail.notes.to_s.strip != notes
        detail.update(attributes: { notes: notes })
        UI.success("App Review notes updated for #{p} version #{v0.version_string}")
      end
    else
      detail = v0.create_app_store_review_detail(attributes: { notes: notes, demo_account_required: false })
      UI.success("Created App Review Information with the review notes for #{p} version #{v0.version_string}")
    end
    # optional screen recording for App Review: REVIEW_ATTACHMENT=path/to/video.mp4
    att = ENV["REVIEW_ATTACHMENT"].to_s
    if !att.empty? && File.exist?(att)
      (detail.app_store_review_attachments || []).each { |old| old.delete! rescue nil }
      Spaceship::ConnectAPI::AppStoreReviewAttachment.create(app_store_review_detail_id: detail.id, path: att)
      UI.success("Attached #{File.basename(att)} to App Review Information (#{p})")
    end
  end
  upload_to_app_store(
    api_key: asc_key, app_identifier: BUNDLE_ID, platform: mac ? "osx" : "ios", app_version: VERSION,
    skip_binary_upload: true, metadata_path: metadata_dir, screenshots_path: shots,
    skip_screenshots: true, submit_for_review: false, force: true,
    run_precheck_before_submit: false, ignore_language_directory_validation: true
  )
  app = Spaceship::ConnectAPI::App.find(BUNDLE_ID)
  keep = Dir.children(metadata_dir).select { |d| File.directory?(File.join(metadata_dir, d)) && d != "review_information" }
  keep << app.primary_locale
  version = app.get_edit_app_store_version(platform: store_platform(p))
  return unless version
  if true
    # deliver does not save the version's text reliably – set it directly from fastlane/metadata
    loc0 = version.get_app_store_version_localizations.find { |l| l.locale == app.primary_locale }
    md = ->(name) { f = File.join(metadata_dir, app.primary_locale, "#{name}.txt"); File.exist?(f) ? File.read(f).strip : nil }
    if loc0
      loc0.update(attributes: { description: md.call("description"), keywords: md.call("keywords"),
                                promotional_text: md.call("promotional_text"), support_url: md.call("support_url"),
                                marketing_url: md.call("marketing_url") }.compact)
      notes = md.call("release_notes")
      if notes && version.version_string != "1.0.0"
        begin
          loc0.update(attributes: { whats_new: notes })
        rescue => e
          UI.important("What's New not set: #{e.message.lines.first}")
        end
      end
      UI.success("#{p} text set for #{app.primary_locale}")
    end
    copyright_file = File.join(metadata_dir, "copyright.txt")
    version.update(attributes: { copyright: File.read(copyright_file).strip }) if File.exist?(copyright_file)
  end
  # screenshots: put them in the right display-type set directly (fastlane 2.241 no longer finds them)
  loc = version.get_app_store_version_localizations.find { |l| l.locale == app.primary_locale }
  files = Dir.glob(File.join(shots, app.primary_locale, "*.png")).sort
  if loc && !files.empty?
    sets = loc.get_app_screenshot_sets
    files.group_by { |f| display_type(f) }.each do |type, fs|
      next unless type
      set = sets.find { |st| st.screenshot_display_type == type } ||
            loc.create_app_screenshot_set(attributes: { screenshotDisplayType: type })
      (set.app_screenshots || []).each { |old| (old.delete! rescue nil) }
      fs.each { |f| set.upload_screenshot(path: f, wait_for_processing: false) }
      UI.message("Uploaded #{fs.size} screenshots to #{type}")
    end
  end
  version.get_app_store_version_localizations.each do |loc|
    next if keep.include?(loc.locale)
    begin
      loc.delete!
      UI.message("Removed language #{loc.locale} from #{p} version #{version.version_string}")
    rescue => e
      UI.important("Could not remove #{loc.locale}: #{e.message}")
    end
  end
  build = app.get_builds(filter: { "preReleaseVersion.platform" => store_platform(p) }, sort: "-uploadedDate")
             .find { |b| b.processing_state == "VALID" && !b.expired }
  if build
    begin
      version.select_build(build_id: build.id)
      UI.success("Build #{build.version} attached to #{p} version #{version.version_string}")
    rescue => e
      UI.important("Could not attach build #{build.version}: #{e.message}")
    end
  else
    UI.important("No processed #{p} build yet – run this again once TestFlight shows the build")
  end
end

def report_status
  asc_key
  app = Spaceship::ConnectAPI::App.find(BUNDLE_ID)
  UI.user_error!("No app with bundle ID #{BUNDLE_ID} in App Store Connect") unless app
  UI.message("APP #{app.name} id=#{app.id} primary_locale=#{app.primary_locale}")
  app.get_app_store_versions.each do |v|
    UI.message("VERSION #{v.platform} #{v.version_string} state=#{v.app_store_state}")
    v.get_app_store_version_localizations.each do |loc|
      sets = loc.get_app_screenshot_sets
      info = sets.map { |st| "#{st.screenshot_display_type}=#{(st.app_screenshots || []).count}" }.join(", ")
      UI.message("   LOCALE #{loc.locale}: #{info.empty? ? 'no screenshots' : info}")
    end
    build = (v.build rescue nil)
    UI.message("   BUILD attached: #{build ? build.version : 'none'}")
  end
  app.get_builds(sort: "-uploadedDate").first(6).each do |b|
    plat = (b.pre_release_version.platform rescue "?")
    UI.message("BUILD #{plat} #{b.version} state=#{b.processing_state} expired=#{b.expired}")
  end
end

REVIEWABLE_STATES = %w[PREPARE_FOR_SUBMISSION READY_FOR_REVIEW DEVELOPER_REJECTED REJECTED METADATA_REJECTED INVALID_BINARY].freeze

def version_for(app, p)
  app.get_app_store_versions.find { |v| v.platform == store_platform(p) && REVIEWABLE_STATES.include?(v.app_store_state) }
end

# Review notes (fastlane/metadata/review_information/notes.txt), contact (copied from the other platform when empty)
# and an optional screen recording (REVIEW_ATTACHMENT) for the App Review Information of one platform.
def update_review_info(p)
  asc_key
  app = Spaceship::ConnectAPI::App.find(BUNDLE_ID)
  v = version_for(app, p)
  UI.user_error!("No #{p} version that can be edited for review") unless v
  notes = File.read(File.join(metadata_dir, "review_information", "notes.txt")).strip
  detail = (v.fetch_app_store_review_detail rescue nil) ||
           v.create_app_store_review_detail(attributes: { notes: notes, demo_account_required: false })
  attrs = { notes: notes, demo_account_required: false }
  if detail.contact_email.to_s.empty?
    other = app.get_app_store_versions.find { |x| x.platform != store_platform(p) }
    src = other && (other.fetch_app_store_review_detail rescue nil)
    if src
      attrs.merge!(contact_first_name: src.contact_first_name, contact_last_name: src.contact_last_name,
                   contact_phone: src.contact_phone, contact_email: src.contact_email)
    end
  end
  detail.update(attributes: attrs)
  UI.success("App Review notes updated for #{p} #{v.version_string} (#{v.app_store_state})")
  att = ENV["REVIEW_ATTACHMENT"].to_s
  if !att.empty? && File.exist?(att)
    detail = v.fetch_app_store_review_detail
    (detail.app_store_review_attachments || []).each { |old| (old.delete! rescue nil) }
    Spaceship::ConnectAPI::AppStoreReviewAttachment.create(app_store_review_detail_id: detail.id, path: att)
    UI.success("Attached #{File.basename(att)} (#{(File.size(att) / 1048576.0).round(1)} MB) to App Review Information (#{p})")
  end
end

def submit_version(p)
  asc_key
  app = Spaceship::ConnectAPI::App.find(BUNDLE_ID)
  v = version_for(app, p)
  UI.user_error!("No #{p} version waiting to be submitted") unless v
  subs = app.get_review_submissions(filter: { platform: store_platform(p) }, includes: "items") rescue []
  subs.each { |x| UI.message("Review submission #{x.id} state=#{x.state} items=#{(x.items || []).count}") }
  # a submission Apple sent back ("Information Needed" / rejection) is resubmitted as it is
  sub = subs.find { |x| x.state == "UNRESOLVED_ISSUES" }
  if sub
    # remove empty submissions left over from earlier attempts
    subs.select { |x| x.state == "READY_FOR_REVIEW" && (x.items || []).empty? }.each do |x|
      (x.cancel_submission rescue nil)
    end
    UI.message("Resubmitting the submission Apple sent back (#{sub.id})")
  else
    subs.select { |x| x.state == "READY_FOR_REVIEW" && (x.items || []).empty? }.each do |x|
      begin
        x.cancel_submission
        UI.message("Cancelled empty review submission #{x.id}")
      rescue => e
        UI.important("Could not cancel empty submission #{x.id}: #{e.message.lines.first}")
      end
    end
    sub = begin
      app.create_review_submission(platform: store_platform(p))
    rescue => e
      UI.important("New review submission refused (#{e.message.lines.first.to_s.strip}) – using the open one")
      app.get_ready_review_submission(platform: store_platform(p))
    end
    begin
      sub.add_app_store_version_to_review_items(app_store_version_id: v.id)
      UI.message("Added version #{v.version_string} to review submission #{sub.id}")
    rescue => e
      UI.important("Adding the version: #{e.message}")
    end
  end
  begin
    sub.submit_for_review
  rescue Spaceship::UnexpectedResponse => e
    UI.error("App Store Connect says: #{e.message}")
    raise
  end
  UI.success("#{p} version #{v.version_string} submitted for App Review")
end

platform :ios do
  desc "Upload the App Store listing (text and screenshots) – does not submit for review"
  lane(:listing) { upload_listing("ios") }
  lane(:review_info) { update_review_info("ios") }
  lane(:submit) { submit_version("ios") }
  desc "Print what App Store Connect has: versions, languages, screenshots, builds"
  lane(:status) { report_status }
end

# ---------------------------------------------------------------- Mac
# The .pkg uploaded to the Mac App Store must be signed with a "Mac Installer Distribution" certificate.
# If the secrets MAC_INSTALLER_P12_BASE64 / MAC_INSTALLER_PASSWORD are not set, a temporary installer
# certificate is created with the API key for this run only and revoked again at the end.
def temp_installer_certificate
  require "openssl"
  require "base64"
  key = OpenSSL::PKey::RSA.new(2048)
  csr = OpenSSL::X509::Request.new
  csr.version = 0
  csr.subject = OpenSSL::X509::Name.parse("/CN=Technical Officials Scheduler build")
  csr.public_key = key.public_key
  csr.sign(key, OpenSSL::Digest::SHA256.new)
  cert = Spaceship::ConnectAPI::Certificate.create(certificate_type: "MAC_INSTALLER_DISTRIBUTION", csr_content: csr.to_pem)
  dir = ENV["RUNNER_TEMP"] || Dir.tmpdir
  key_path = File.join(dir, "installer-temp.key")
  cer_path = File.join(dir, "installer-temp.cer")
  File.write(key_path, key.to_pem)
  File.binwrite(cer_path, Base64.decode64(cert.certificate_content))
  kc = File.expand_path("~/Library/Keychains/#{KEYCHAIN}-db")
  sh("security import '#{key_path}' -k '#{kc}' -t priv -f openssl -A")
  sh("security import '#{cer_path}' -k '#{kc}' -A")
  sh("security set-key-partition-list -S apple-tool:,apple:,codesign: -s -k '' '#{kc}' > /dev/null")
  File.delete(key_path)
  UI.success("Temporary Mac Installer Distribution certificate #{cert.id} created")
  cert.id
end

platform :mac do
  desc "Build the Mac app and upload it to TestFlight"
  lane :beta do
    key = asc_key
    prepare_keychain([[ENV.fetch("DIST_CERT_PATH"), ENV.fetch("DIST_CERT_PASSWORD")]])
    unless ENV["MAC_INSTALLER_CERT_PATH"].to_s.empty?
      begin
        import_certificate(certificate_path: ENV["MAC_INSTALLER_CERT_PATH"], certificate_password: ENV["MAC_INSTALLER_PASSWORD"].to_s,
                           keychain_name: KEYCHAIN, keychain_password: "")
      rescue => e
        UI.important("Stored installer certificate could not be imported: #{e.message}")
      end
    end
    kc = File.expand_path("~/Library/Keychains/#{KEYCHAIN}-db")
    found = sh("security find-identity -v -p basic '#{kc}' || true", log: false)
    have_installer = found =~ /(Mac Installer Distribution|3rd Party Mac Developer Installer)/
    UI.important("No usable installer certificate in the secrets – using a temporary one for this run") unless have_installer
    temp_id = have_installer ? nil : temp_installer_certificate
    begin
      get_provisioning_profile(api_key: key, app_identifier: BUNDLE_ID, team_id: TEAM_ID, platform: "macos")
      profile = lane_context[SharedValues::SIGH_NAME]
      build_app(
        project: "TOScheduler.xcodeproj", scheme: "TOScheduler-macOS", configuration: "Release",
        export_method: "app-store", xcargs: signing_args(profile),
        export_options: { signingStyle: "manual", teamID: TEAM_ID, provisioningProfiles: { BUNDLE_ID => profile },
                          signingCertificate: "Apple Distribution",
                          installerSigningCertificate: "3rd Party Mac Developer Installer" },
        output_directory: "build", output_name: "TOScheduler.pkg"
      )
      upload_to_testflight(api_key: key, pkg: lane_context[SharedValues::PKG_OUTPUT_PATH], app_platform: "osx", skip_waiting_for_build_processing: true)
    ensure
      if temp_id
        begin
          Spaceship::ConnectAPI.delete_certificate(certificate_id: temp_id)
          UI.message("Temporary installer certificate revoked")
        rescue => e
          UI.important("Could not revoke temporary installer certificate #{temp_id}: #{e.message}")
        end
      end
    end
  end

  desc "Upload the Mac App Store listing (text and screenshots) – does not submit for review"
  lane(:listing) { upload_listing("mac") }

  lane(:review_info) { update_review_info("mac") }
  lane(:submit) { submit_version("mac") }
end
